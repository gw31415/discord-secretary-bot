[Unit]
Description=discord-admin-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/discord-admin-bot
EnvironmentFile=/opt/discord-admin-bot/.env
ExecStart=/usr/bin/node src/index.ts
Restart=on-failure
RestartSec=5
User=discord-bot
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/discord-admin-bot/data

[Install]
WantedBy=multi-user.target
