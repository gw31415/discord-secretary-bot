# One unit per environment: discord-secretary-bot@prod and discord-secretary-bot@dev.
# `botctl install` writes this to /etc/systemd/system with @ROOT@ and @NODE@ filled in.
#
# Each environment runs as its own user (secretary-prod / secretary-dev), not as
# the user that deploys: it cannot read the other environment's process, or that
# user's files and processes. The .env is root:root 600: systemd reads it before
# dropping to the service user, so the bot gets the values but cannot open the
# file. Under /home only the environment's own clone (read-only, through ACLs
# that botctl install sets) and its data are visible.
[Unit]
Description=discord-secretary-bot (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secretary-%i
Group=secretary-%i
SupplementaryGroups=wasm-compiler-clients
WorkingDirectory=@ROOT@/%i
EnvironmentFile=@ROOT@/%i/.env
ExecStart=@NODE@ src/index.ts
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@ROOT@/%i
BindPaths=@ROOT@/%i/data
InaccessiblePaths=@ROOT@/%i/.env
ProtectProc=invisible
PrivateTmp=true

[Install]
WantedBy=multi-user.target
