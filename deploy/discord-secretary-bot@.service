# One unit per environment: discord-secretary-bot@prod and discord-secretary-bot@dev.
# `botctl install` writes this to /etc/systemd/system with @ROOT@, @NODE@ and @USER@ filled in.
[Unit]
Description=discord-secretary-bot (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@/%i
EnvironmentFile=@ROOT@/%i/.env
ExecStart=@NODE@ src/index.ts
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=@ROOT@/%i/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
