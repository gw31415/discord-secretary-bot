#!/usr/bin/env bash
# Production and development on one host: each has its own clone, .env, database
# and systemd unit (discord-secretary-bot@prod / discord-secretary-bot@dev).
#
#   botctl status              what each environment runs
#   botctl dev [branch]        move dev to the branch's latest commit (default: main), test, restart
#   botctl promote [commit]    put what dev runs into production
#   botctl rollback            put production back on the commit it ran before
#   botctl logs prod|dev [n]   recent log lines
#   botctl install             one-time setup of the layout and the units
#   botctl compiler ...        the Wasm compiler service (botctl compiler help)
#
# Production only runs a commit that dev is running. Before every production
# change the database is copied to prod/data/backups; if the new commit does not
# start, production goes back to the old commit and that copy by itself.
set -euo pipefail

ROOT="${BOT_ROOT:-$HOME/discord-secretary-bot}"
REPO="${BOT_REPO:-https://github.com/gw31415/discord-secretary-bot.git}"
NODE="${BOT_NODE:-$HOME/.local/share/mise/installs/node/26.8.2/bin/node}"
UNIT="discord-secretary-bot"
# The units' node: a root-owned copy, since the services cannot see $HOME.
SERVICE_NODE="/opt/discord-secretary-bot/node"
STATE="$ROOT/state"
PATH="$(dirname "$NODE"):$PATH"
export PATH

say() { printf '%s\n' "$*"; }
die() { printf 'エラー: %s\n' "$*" >&2; exit 1; }

unit() { printf '%s@%s' "$UNIT" "$1"; }
head_of() { git -C "$ROOT/$1" rev-parse HEAD; }
short() { git -C "$ROOT/prod" rev-parse --short "$1"; }
describe() { git -C "$ROOT/$1" log -1 --format='%h %s'; }

# Up to 60 s for the bot to log in; fails as soon as the unit is not running.
healthy() {
  local env="$1" since="$2"
  for _ in $(seq 60); do
    sleep 1
    systemctl is-active --quiet "$(unit "$env")" || return 1
    if journalctl -u "$(unit "$env")" --since "$since" --no-pager -o cat 2>/dev/null | grep -q 'としてログインしました'; then
      return 0
    fi
  done
  return 1
}

start() {
  local env="$1" since
  since="$(date '+%Y-%m-%d %H:%M:%S')"
  sudo systemctl restart "$(unit "$env")"
  healthy "$env" "$since"
}

# npm ci only when the lockfile changed since the last install in that clone.
deps() {
  local dir="$ROOT/$1" hash
  hash="$(sha256sum "$dir/package-lock.json" | cut -d' ' -f1)"
  if [[ ! -f "$dir/node_modules/.lock-hash" || "$(cat "$dir/node_modules/.lock-hash")" != "$hash" ]]; then
    (cd "$dir" && npm ci --no-audit --no-fund --loglevel=error)
    printf '%s' "$hash" >"$dir/node_modules/.lock-hash"
  fi
}

tests() {
  local out
  if out="$(cd "$ROOT/$1" && npm test 2>&1)"; then
    grep -E '^. (pass|fail) ' <<<"$out" || true
  else
    tail -n 40 <<<"$out" >&2
    return 1
  fi
}

# The unit is stopped, so copying the main file gives a consistent database.
backup() {
  local dir="$ROOT/prod/data/backups" name
  mkdir -p "$dir"
  name="$dir/$(date '+%Y%m%d-%H%M%S')-$(short "$1").db"
  cp "$ROOT/prod/data/bot.db" "$name"
  chmod 600 "$name"
  printf '%s' "$name"
}

record() { printf '%s %s %s\n' "$(date -Is)" "$1" "$2" >>"$STATE/prod-history"; }

cmd_status() {
  local env dir branch
  for env in prod dev; do
    dir="$ROOT/$env"
    if [[ ! -d "$dir/.git" ]]; then
      say "$env: 未設置"
      continue
    fi
    branch="$(git -C "$dir" symbolic-ref --short -q HEAD || echo 'コミット固定')"
    say "$env: $(systemctl is-active "$(unit "$env")" 2>/dev/null || true) · $branch · $(describe "$env")"
  done
  if [[ -f "$STATE/prod-history" ]]; then
    say "本番の履歴(新しい順):"
    tail -n 5 "$STATE/prod-history" | tac
  fi
}

cmd_dev() {
  local branch="${1:-main}" dir="$ROOT/dev"
  git -C "$dir" fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch"
  git -C "$dir" checkout -q -B "$branch" "origin/$branch"
  deps dev
  tests dev || die "dev のテストが失敗したので、dev は再起動していません"
  start dev || die "dev が起動しませんでした(botctl logs dev)"
  say "dev を $branch の $(describe dev) にしました"
}

cmd_promote() {
  local sha
  sha="$(head_of dev)"
  if [[ $# -gt 0 && "$(git -C "$ROOT/dev" rev-parse --verify -q "$1^{commit}" || true)" != "$sha" ]]; then
    die "本番に上げられるのは dev で動いているコミットだけです(dev: $(describe dev))"
  fi
  systemctl is-active --quiet "$(unit dev)" || die "dev が止まっています。dev で動くことを確かめてから上げてください"
  switch_prod "$sha" promote
}

cmd_rollback() {
  [[ -f "$STATE/prod-history" ]] || die "本番の履歴がありません"
  local current previous
  current="$(head_of prod)"
  # The last commit production ran other than the current one.
  previous="$(awk -v cur="$current" '$2 != cur { sha = $2 } END { print sha }' "$STATE/prod-history")"
  [[ -n "$previous" ]] || die "戻せる以前のコミットがありません"
  switch_prod "$previous" rollback
}

switch_prod() {
  local sha="$1" why="$2" dir="$ROOT/prod" previous saved
  previous="$(head_of prod)"
  if [[ "$sha" == "$previous" ]]; then
    say "本番はすでに $(describe prod) です"
    return 0
  fi
  git -C "$dir" fetch -q origin
  git -C "$dir" cat-file -e "$sha^{commit}" 2>/dev/null || die "コミット $sha が GitHub にありません(push してください)"

  sudo systemctl stop "$(unit prod)"
  saved="$(backup "$previous")"
  git -C "$dir" checkout -q --detach "$sha"
  if deps prod && tests prod && start prod; then
    record "$sha" "$why"
    say "本番を $(describe prod) にしました(更新前のデータベース: $saved)"
    return 0
  fi

  say "本番の更新に失敗したので $(short "$previous") に戻します" >&2
  sudo systemctl stop "$(unit prod)" || true
  git -C "$dir" checkout -q --detach "$previous"
  cp "$saved" "$dir/data/bot.db"
  rm -f "$dir/data/bot.db-wal" "$dir/data/bot.db-shm"
  deps prod
  start prod || die "元のコミットでも起動しませんでした(botctl logs prod)"
  die "本番は $(describe prod) のままです(データベースも更新前に戻しました)"
}

cmd_logs() {
  journalctl -u "$(unit "${1:-prod}")" -n "${2:-50}" --no-pager -o cat
}

# The environment's own user reads its clone and writes its data; default ACLs
# keep that true for what git and npm write later, and let this user read and
# replace the database the service writes. The .env stays root:root 600.
access() {
  local user="secretary-$1" dir="$ROOT/$1"
  id "$user" >/dev/null 2>&1 || sudo useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$user"
  if [[ -f "$dir/.env" ]]; then
    sudo chown root:root "$dir/.env"
    sudo chmod 600 "$dir/.env"
  fi
  # The .env is root's, so setfacl only reports it.
  setfacl -R -m "u:$user:rX,d:u:$user:rX" "$dir" 2>/dev/null || true
  setfacl -R -m "u:$user:rwX,d:u:$user:rwX,d:u:$(id -un):rwX" "$dir/data"
}

cmd_install() {
  local env
  mkdir -p "$STATE"
  command -v setfacl >/dev/null || sudo apt-get install -y -q acl
  getent group wasm-compiler-clients >/dev/null || sudo groupadd --system wasm-compiler-clients
  for env in prod dev; do
    [[ -d "$ROOT/$env/.git" ]] || git clone -q "$REPO" "$ROOT/$env"
    mkdir -p "$ROOT/$env/data"
    chmod 700 "$ROOT" "$ROOT/$env" "$ROOT/$env/data"
    access "$env"
  done
  sudo install -D -m 755 "$NODE" "$SERVICE_NODE"
  sed -e "s#@ROOT@#$ROOT#g" -e "s#@NODE@#$SERVICE_NODE#g" \
    "$ROOT/dev/deploy/$UNIT@.service" | sudo tee "/etc/systemd/system/$UNIT@.service" >/dev/null
  sudo systemctl daemon-reload
  # A copy, so checking out another branch in dev never changes the tool itself.
  sudo install -m 755 "$ROOT/dev/deploy/botctl" /usr/local/bin/botctl
  say "設置しました。prod/.env と dev/.env を用意したら、もう一度 botctl install を実行して(.env を root だけが読めるようにします)から: sudo systemctl enable --now $UNIT@prod $UNIT@dev"
}

# --- wasm-compiler ------------------------------------------------------------
# A service of its own (deploy/wasm-compiler.service): user wasmc, code and
# toolchains under /opt/wasm-compiler (root-owned, so the service cannot change
# them), and a socket the bot reaches through the wasm-compiler-clients group.
CHOME=/opt/wasm-compiler
CUNIT=wasm-compiler

compiler_node() { sudo env WASM_COMPILER_HOME="$CHOME" WASM_COMPILER_JOBS=/var/tmp/wasm-compiler-setup "$CHOME/node" "$CHOME/app/src/main.ts" "$@"; }

cmd_compiler() {
  local sub="${1:-status}" src
  shift || true
  case "$sub" in
    install)
      # Code from a clone (default: what production runs), copied so the service never reads a home directory.
      src="${1:-$ROOT/prod}"
      [[ -d "$src/compiler/src" ]] || die "$src/compiler がありません"
      getent group wasm-compiler-clients >/dev/null || sudo groupadd --system wasm-compiler-clients
      id wasmc >/dev/null 2>&1 || sudo useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin wasmc
      id -nG "$(id -un)" | grep -qw wasm-compiler-clients || sudo usermod -aG wasm-compiler-clients "$(id -un)"
      sudo install -d -m 755 "$CHOME" "$CHOME/toolchains" "$CHOME/rootfs"
      sudo rm -rf "$CHOME/app.new"
      sudo cp -r "$src/compiler" "$CHOME/app.new"
      sudo rm -rf "$CHOME/app.old"
      [[ -d "$CHOME/app" ]] && sudo mv "$CHOME/app" "$CHOME/app.old"
      sudo mv "$CHOME/app.new" "$CHOME/app"
      sudo chown -R root:root "$CHOME/app"
      sudo chmod -R u=rwX,go=rX "$CHOME/app"
      sudo install -m 755 "$NODE" "$CHOME/node"
      # Its own bwrap, so the AppArmor profile that lets it make user namespaces covers nothing else.
      sudo install -D -m 755 /usr/bin/bwrap "$CHOME/bin/bwrap"
      if [[ -d /sys/kernel/security/apparmor && -d /etc/apparmor.d ]]; then
        sudo install -m 644 "$src/deploy/apparmor/wasm-compiler-bwrap" /etc/apparmor.d/wasm-compiler-bwrap
        sudo apparmor_parser -r /etc/apparmor.d/wasm-compiler-bwrap
      fi
      printf 'WASM_COMPILER_SOCKET_GID=%s\nBWRAP=%s\n' "$(getent group wasm-compiler-clients | cut -d: -f3)" "$CHOME/bin/bwrap" | sudo tee "$CHOME/env" >/dev/null
      sudo install -m 644 "$src/deploy/$CUNIT.service" "/etc/systemd/system/$CUNIT.service"
      sudo systemctl daemon-reload
      sudo systemctl enable -q "$CUNIT"
      sudo systemctl restart "$CUNIT"
      say "wasm-compiler を $(git -C "$src" log -1 --format='%h %s') にしました"
      ;;
    rootfs) command -v mmdebstrap >/dev/null || sudo apt-get install -y -q mmdebstrap; compiler_node rootfs "${1:-base}" ;;
    setup) [[ $# -gt 0 ]] || die "言語を指定してください(c, rust, go, moonbit, zig, nim など)"; for lang in "$@"; do compiler_node setup "$lang"; done; sudo systemctl restart "$CUNIT" ;;
    # As a unit with the service's own limits (read from its unit file), so it meets the same AppArmor, seccomp and mounts.
    selftest)
      local props=()
      while IFS= read -r line; do props+=(-p "$line"); done < <(grep -E '^(NoNewPrivileges|Protect|Private|Restrict|Lock|Memory|CPU|Tasks)' "/etc/systemd/system/$CUNIT.service")
      sudo systemd-run --quiet --wait --pipe --collect -p User=wasmc -p EnvironmentFile="$CHOME/env" -p StateDirectory=wasm-compiler "${props[@]}" \
        -E WASM_COMPILER_HOME="$CHOME" -E WASM_COMPILER_JOBS=/var/lib/wasm-compiler/selftest \
        "$CHOME/node" "$CHOME/app/src/main.ts" selftest ;;
    status)
      say "wasm-compiler: $(systemctl is-active "$CUNIT" 2>/dev/null || true)"
      sudo curl -fsS --unix-socket /run/wasm-compiler/compiler.sock http://compiler/v1/languages 2>/dev/null \
        | "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{for(const l of JSON.parse(s).languages)console.log(`  ${l.id}: ${l.name} ${l.version} ${l.ready?"":"(未セットアップ)"}`)})' || true
      ;;
    logs) journalctl -u "$CUNIT" -n "${1:-50}" --no-pager -o cat ;;
    *) die "使い方: botctl compiler install [clone] | rootfs [name] | setup <言語>... | selftest | status | logs [n]" ;;
  esac
}

case "${1:-status}" in
  status) cmd_status ;;
  dev) shift; cmd_dev "$@" ;;
  promote) shift; cmd_promote "$@" ;;
  rollback) cmd_rollback ;;
  logs) shift; cmd_logs "$@" ;;
  install) cmd_install ;;
  compiler) shift; cmd_compiler "$@" ;;
  *) die "使い方: botctl status | dev [branch] | promote [commit] | rollback | logs prod|dev [n] | install | compiler ..." ;;
esac
